APP_ENV=dev
APP_NAME=ai-orchestrator-backend
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://YOUR_LOCAL_DB_USER@127.0.0.1:5432/ai_orchestrator
MASTER_KEY=GENERATE_WITH_FERNET
VECTOR_BACKEND=memory
SHORT_TERM_MAX_MESSAGES=20
VECTOR_TOP_K=3
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=meta-llama/llama-3.3-8b-instruct:free
DECISION_LLM_PROVIDER=openrouter
DECISION_LLM_MODEL=meta-llama/llama-3.3-8b-instruct:free
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PYTHON_TOOL_TIMEOUT_SECONDS=3
BASH_TOOL_TIMEOUT_SECONDS=10
HTTP_TOOL_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
DEEP_SEARCH_MAX_PAGES=3
