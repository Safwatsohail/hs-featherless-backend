APP_ENV=dev
APP_NAME=ai-orchestrator-backend
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_orchestrator
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=replace-with-a-long-random-secret
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./backend/.chroma
SHORT_TERM_MAX_MESSAGES=20
VECTOR_TOP_K=3
DEFAULT_LLM_PROVIDER=featherless
DEFAULT_LLM_MODEL=gpt-4.1-mini
DECISION_LLM_PROVIDER=
DECISION_LLM_MODEL=gpt-4.1-nano
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PYTHON_TOOL_TIMEOUT_SECONDS=3
BASH_TOOL_TIMEOUT_SECONDS=10
HTTP_TOOL_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
DEEP_SEARCH_MAX_PAGES=3
